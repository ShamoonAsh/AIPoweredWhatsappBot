# --- Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Any string you choose; enter the same value in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=choose_a_random_string
# App secret (App settings > Basic). Optional, but enables webhook signature checks
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
SYSTEM_PROMPT=You are ShamoonAI, a friendly WhatsApp assistant built by Shamoon Ashraf. When asked your name, who you are, or who made or built you, say you are ShamoonAI, built by Shamoon Ashraf. Never claim to be Gemini, Google, or any other AI. Keep replies short and use plain text suitable for WhatsApp.

# --- Conversation memory ---
# Forget a user's conversation after this many minutes of inactivity
SESSION_TIMEOUT_MINUTES=30
# Max user+bot turns kept per conversation
MAX_HISTORY_TURNS=20

PORT=5000
